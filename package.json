{
  "name": "krisharyan12-profile",
  "private": true,
  "version": "1.0.0",
  "description": "Generator for the KrishAryan12 GitHub profile README: The Grid, but it's production.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:tokens": "tsx tools/src/tokens/build.ts",
    "build:logos": "tsx tools/src/logos/build.ts",
    "build:panels": "tsx tools/src/panels/build.ts",
    "build:readme": "tsx tools/src/readme/build.ts",
    "render:hero": "tsx tools/render3d/render.ts",
    "build": "pnpm build:tokens && pnpm build:logos && pnpm build:panels && pnpm build:readme",
    "preview": "tsx tools/src/preview/serve.ts",
    "qa": "tsx tools/src/preview/qa.ts",
    "dynamic": "tsx tools/src/dynamic/run.ts",
    "typecheck": "tsc --noEmit",
    "lint:links": "tsx tools/src/lint/links.ts",
    "check": "pnpm typecheck && tsx tools/src/lint/run.ts"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/oxanium": "^5.3.0",
    "@types/node": "^26.6.4",
    "@types/opentype.js": "^1.3.10",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "fast-xml-parser": "^5.11.2",
    "github-markdown-css": "^5.9.0",
    "marked": "^18.0.14",
    "opentype.js": "^2.0.0",
    "playwright": "^1.63.0",
    "simple-icons": "^16.34.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
